# OTC sandbox image.
#
# Both inputs are explicit build arguments: the Node base and the OpenCode CLI
# version. The recipe does not float. A campaign freezes the resolved image ID
# and the CLI version it contains before any dispatch.
FROM ${NODE_BASE}

ARG HOST_UID=1000
ARG HOST_GID=1000
ARG OPENCODE_VERSION

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && test -n "${OPENCODE_VERSION}" \
    && npm install -g --silent "@opencode/cli@${OPENCODE_VERSION}" \
    && mkdir -p /workspace /tmp/agent-home \
    && chown -R "${HOST_UID}:${HOST_GID}" /workspace /tmp/agent-home

USER ${HOST_UID}:${HOST_GID}
WORKDIR /workspace
ENV HOME=/tmp/agent-home
