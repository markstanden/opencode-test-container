{
    "schemaVersion": 1,
    "campaignId": "docs-rehearsal-local",
    "suite": {
        "path": "suite.json"
    },
    "subjects": [
        {
            "armId": "docs-plugin",
            "plugins": [
                {
                    "id": "docs",
                    "path": "DOCS_PLUGIN_PATH"
                }
            ]
        }
    ],
    "schedule": {
        "kind": "explicit",
        "slots": [
            {
                "slotId": "useful-write",
                "caseId": "useful-write",
                "armId": "docs-plugin",
                "repetitionId": "r0"
            },
            {
                "slotId": "gate-blocked",
                "caseId": "gate-blocked",
                "armId": "docs-plugin",
                "repetitionId": "r0"
            }
        ]
    },
    "runtime": {
        "image": "localhost/opencode-placement-trials:latest",
        "opencodeVersion": "2.2.6",
        "provider": {
            "route": "scripted",
            "model": "zai-coding-plan/glm-5.3-flash",
            "overlay": {
                "providers": {
                    "zai-coding-plan": {
                        "settings": {
                            "baseURL": "http://127.0.0.1:8799/v1"
                        }
                    }
                }
            }
        },
        "timeoutMs": 180000,
        "network": "host",
        "passthroughEnv": ["ZAI_API_KEY"]
    },
    "budgets": {
        "trials": 2,
        "judgeAttempts": 0
    },
    "assessment": {
        "kind": "docs-recording"
    },
    "stopOnFirstFailure": false
}
