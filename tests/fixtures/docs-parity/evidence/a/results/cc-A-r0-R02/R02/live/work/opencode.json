{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "plugins": [
    {
      "package": "/repo",
      "options": {
        "lakes": [
          {
            "class": "repo",
            "root": "../lakes/docs",
            "name": "docs",
            "description": "This repository's decisions and traps."
          }
        ]
      }
    }
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
